<?xml version="1.0" encoding="utf-8"?>
<!-- Dashboard: cabecera superior sobre superficie oscura (traducción del "header"
     clínico del escritorio; en móvil no usamos barra lateral) y, debajo, la lista
     de citas como RecyclerView sobre el fondo gris muy claro. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <!-- Cabecera: se funde con la barra de estado (mismo color) para un bloque
         clínico continuo. El saludo va en blanco y el subtítulo en el acento suave. -->
    <LinearLayout
        android:id="@+id/headerDashboard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/color_surface_dark"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textViewSaludo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/dashboard_saludo"
            android:textColor="@color/color_on_primary"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textViewSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/dashboard_subtitulo"
            android:textColor="@color/color_primary_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewCitas"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerDashboard" />

    <!-- Empty state: centrado sobre el área del RecyclerView, oculto por defecto -->
    <TextView
        android:id="@+id/textViewEmpty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_empty"
        android:textColor="@color/color_text_secondary"
        android:textSize="16sp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/recyclerViewCitas"
        app:layout_constraintEnd_toEndOf="@id/recyclerViewCitas"
        app:layout_constraintStart_toStartOf="@id/recyclerViewCitas"
        app:layout_constraintTop_toTopOf="@id/recyclerViewCitas" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabChat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        android:contentDescription="@string/fab_chat_desc"
        android:src="@drawable/ic_chat"
        app:backgroundTint="@color/color_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:tint="@color/color_on_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
