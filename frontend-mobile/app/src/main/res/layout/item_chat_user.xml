<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de mensaje del usuario. El contenedor ocupa el ancho completo y la
     burbuja se alinea a la derecha (layout_gravity="end"). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="4dp">

    <TextView
        android:id="@+id/textMensaje"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="48dp"
        android:background="@drawable/bg_bubble_user"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:textColor="@color/color_text_primary"
        android:textSize="16sp"
        tools:text="Hola, quiero pedir una cita para mañana."
        xmlns:tools="http://schemas.android.com/tools" />
</LinearLayout>
