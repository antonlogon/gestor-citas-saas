# Configuración del backend (FastAPI + SQLAlchemy).
# Copia este archivo a .env y rellena los valores reales:
#   cp .env.example .env
# El archivo .env NO se versiona (ver .gitignore).

# --- Base de datos (MySQL) ---
# Formato: mysql+pymysql://usuario:contraseña@host:puerto/basededatos
# El puerto 3307 corresponde al mapeo de Docker (ver database/docker-compose.yml).
DATABASE_URL=mysql+pymysql://root:CHANGE_ME@127.0.0.1:3307/gestor_citas_saas

# --- JWT ---
# Genera una clave nueva con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Asistente virtual (modelo de lenguaje) ---
# Proveedor del LLM (API compatible con OpenAI). Los valores por defecto del
# código apuntan a LM Studio en local; para un proveedor gestionado basta cambiar
# estas variables, sin tocar código.
LLM_BASE_URL=http://localhost:1234/v1
# La clave es un SECRETO al apuntar a un proveedor real: nunca pongas aquí un
# valor real. En LM Studio local no se valida.
LLM_API_KEY=CHANGE_ME
# Modelo cargado en el proveedor. qwen2.5-7b-instruct es el usado en desarrollo:
# sigue mejor las instrucciones de uso de herramientas que llama-3.1-8b.
LLM_MODEL=qwen2.5-7b-instruct
# Tiempo máximo de espera por CADA llamada al modelo (segundos).
LLM_TIMEOUT_SECONDS=30
