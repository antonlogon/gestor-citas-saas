<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12.0" styleClass="citas-root"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.frontenddesktop.controllers.ServiciosController">

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="refreshButton" styleClass="button-secondary" text="Refrescar"
                onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="serviciosTable" styleClass="data-table" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nombreColumn" text="Nombre" prefWidth="260.0"/>
            <TableColumn fx:id="duracionColumn" text="Duración (min)" prefWidth="150.0"/>
            <TableColumn fx:id="precioColumn" text="Precio" prefWidth="130.0"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>

    <!-- Línea de estado discreta (recuento / mensajes de error). -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" styleClass="status-label"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
