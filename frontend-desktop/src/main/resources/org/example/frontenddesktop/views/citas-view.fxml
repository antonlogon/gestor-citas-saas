<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="18.0" styleClass="citas-root"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.frontenddesktop.controllers.CitasController">

    <!-- ===================== Fila de KPIs ===================== -->
    <!-- Se calculan en cliente a partir de la lista ya cargada (sin endpoints
         nuevos). Cada tarjeta lleva un acento de color a la izquierda. -->
    <!-- Las tarjetas son CLICABLES: al pulsarlas filtran la tabla de abajo por
         ese criterio. El cableado del clic y el estado activo se hacen en el
         controlador (CitasController.configurarKpisClicables). -->
    <HBox styleClass="kpi-row" spacing="16.0">
        <VBox fx:id="tarjetaHoy" styleClass="kpi-card, kpi-hoy" HBox.hgrow="ALWAYS">
            <Label fx:id="kpiHoy" styleClass="kpi-value" text="0"/>
            <Label styleClass="kpi-label" text="Citas hoy"/>
        </VBox>
        <VBox fx:id="tarjetaPendientes" styleClass="kpi-card, kpi-pendientes" HBox.hgrow="ALWAYS">
            <Label fx:id="kpiPendientes" styleClass="kpi-value" text="0"/>
            <Label styleClass="kpi-label" text="Pendientes"/>
        </VBox>
        <VBox fx:id="tarjetaConfirmadas" styleClass="kpi-card, kpi-confirmadas" HBox.hgrow="ALWAYS">
            <Label fx:id="kpiConfirmadas" styleClass="kpi-value" text="0"/>
            <Label styleClass="kpi-label" text="Confirmadas"/>
        </VBox>
        <VBox fx:id="tarjetaCanceladas" styleClass="kpi-card, kpi-canceladas" HBox.hgrow="ALWAYS">
            <Label fx:id="kpiCanceladas" styleClass="kpi-value" text="0"/>
            <Label styleClass="kpi-label" text="Canceladas"/>
        </VBox>
    </HBox>

    <!-- ===================== Barra de herramientas ===================== -->
    <HBox styleClass="toolbar" spacing="10.0" alignment="CENTER_LEFT">
        <Button fx:id="nuevaButton" styleClass="button-primary" text="Nueva cita"
                onAction="#onNueva"/>
        <TextField fx:id="searchField" styleClass="search-field" HBox.hgrow="ALWAYS"
                   promptText="Buscar por paciente, servicio o profesional…"/>
        <ComboBox fx:id="estadoFilter" styleClass="filter-combo"/>
        <!-- Refrescar como acción secundaria (no primaria). -->
        <Button fx:id="refreshButton" styleClass="button-secondary" text="Refrescar"
                onAction="#onRefresh"/>
    </HBox>

    <!-- ===================== Tabla + overlay de carga ===================== -->
    <StackPane VBox.vgrow="ALWAYS">
        <TableView fx:id="citasTable" styleClass="data-table">
            <columns>
                <TableColumn fx:id="fechaColumn" text="Fecha / Hora" prefWidth="180.0"/>
                <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="130.0"/>
                <TableColumn fx:id="clienteColumn" text="Paciente" prefWidth="150.0"/>
                <TableColumn fx:id="empleadoColumn" text="Empleado" prefWidth="140.0"/>
                <TableColumn fx:id="servicioColumn" text="Servicio" prefWidth="140.0"/>
                <TableColumn fx:id="accionesColumn" text="Acciones" prefWidth="290.0" sortable="false"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>

        <!-- Indicador de carga sobre el contenido (sustituye al "Cargando…"). -->
        <ProgressIndicator fx:id="progressIndicator" styleClass="loading-spinner"
                           maxWidth="56.0" maxHeight="56.0" visible="false"/>
    </StackPane>

    <!-- Línea de estado discreta (recuento / mensajes de error). -->
    <HBox alignment="CENTER_LEFT">
        <Label fx:id="statusLabel" styleClass="status-label"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
</VBox>
