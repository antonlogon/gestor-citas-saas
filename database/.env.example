# Variables para database/docker-compose.yml.
# Copia este archivo a .env en esta misma carpeta y define los valores:
#   cp .env.example .env
# El archivo .env NO se versiona (ver .gitignore).
# MYSQL_ROOT_PASSWORD es obligatoria: docker-compose la exige sin valor por defecto.

MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_DATABASE=gestor_citas_saas
